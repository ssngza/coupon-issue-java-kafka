# EC2 운영 배포용 예시입니다. 실제 비밀번호와 토큰으로 교체하고 .env로 저장합니다.
APP_IMAGE=my-coupon-app:latest
NGINX_HTTP_PORT=80
MYSQL_DATABASE=coupon_db
MYSQL_USER=coupon
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
COUPON_ADMIN_TOKEN=replace-with-a-long-random-admin-token
